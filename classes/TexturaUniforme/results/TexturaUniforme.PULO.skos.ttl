@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tex: <http://example.org/textura#> .

tex:TexturaUniforme a owl:Class,
        skos:Concept ;
    owl:disjointWith tex:TexturaHeterogenea ;
    skos:altLabel "constante"@pt-PT,
        "imutável"@pt-PT,
        "invariável"@pt-PT,
        "uniforme"@pt-PT ;
    skos:prefLabel "uniforme"@pt-PT ;
    skos:scopeNote "Eixo definidor: invariância face a um parâmetro"@pt-PT .

