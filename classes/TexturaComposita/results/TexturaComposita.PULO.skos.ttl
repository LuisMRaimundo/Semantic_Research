@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tex: <http://example.org/textura#> .

tex:TexturaComposita a owl:Class,
        skos:Concept ;
    tex:termoRelacionado tex:amalgamado,
        tex:cabrito,
        tex:combinacao,
        tex:composicao,
        tex:constituicao,
        tex:diverso,
        tex:hibrido,
        tex:mesclado,
        tex:mestico,
        tex:misto,
        tex:misturado,
        tex:mulato ;
    skos:prefLabel "textura compósita"@pt-PT ;
    skos:scopeNote "Eixo definidor: heterogeneidade / composição de materiais ou partes distintas"@pt-PT .

