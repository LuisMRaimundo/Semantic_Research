@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://example.org/textura#> .

:TexturaComposita a skos:Concept, owl:Class ;
    skos:prefLabel "textura compósita"@pt-PT ;
    skos:scopeNote "Eixo definidor: heterogeneidade / composição de materiais ou partes distintas"@pt-PT ;
    skos:altLabel "compósito"@pt-PT ;
    skos:altLabel "materiais compostos"@pt-PT ;
    skos:altLabel "dissimilar"@pt-PT ;
    skos:altLabel "heterogéneo"@pt-PT ;
    skos:altLabel "dessemelhante"@pt-PT ;
    skos:altLabel "constituído"@pt-PT ;
    skos:altLabel "composto"@pt-PT ;
    skos:altLabel "formado"@pt-PT ;
    skos:altLabel "elaborado"@pt-PT ;
    skos:altLabel "feito"@pt-PT ;
    skos:altLabel "mesclado"@pt-PT ;
    :termoRelacionado :absimilhante ;
    :termoRelacionado :dissimil ;
    :termoRelacionado :dispar ;
    :termoRelacionado :dissemelhante ;
    :termoRelacionado :diferente ;
    :termoRelacionado :aprimorado ;
    :termoRelacionado :bem-avindo ;
    :termoRelacionado :misto ;
    :termoRelacionado :conciliado ;
    :termoRelacionado :concordado .
