@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix skosxl: <http://www.w3.org/2008/05/skos-xl#> .
@prefix tex: <http://example.org/textura#> .

tex:TexturaDensa a owl:Class,
        skos:Concept ;
    tex:termoRelacionado tex:concentracao ;
    skos:prefLabel "TexturaDensa"@pt ;
    skos:scopeNote "Eixo definidor: densidade"@pt ;
    skosxl:altLabel [ skosxl:literalForm "denso"@pt ],
        [ skosxl:literalForm "densidade"@pt ] .

