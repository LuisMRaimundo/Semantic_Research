@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix skosxl: <http://www.w3.org/2008/05/skos-xl#> .
@prefix tex: <http://example.org/textura#> .

tex:TexturaIntermitente a owl:Class,
        skos:Concept ;
    skos:prefLabel "TexturaIntermitente"@pt ;
    skos:scopeNote "Eixo definidor: que ocorre espaçadamente, a intervalos, regulares ou irregulares"@pt ;
    skosxl:altLabel [ skosxl:literalForm "intermitente"@pt ] .

